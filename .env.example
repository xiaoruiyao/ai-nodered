# ==========================================
# Node-RED MCP Server Configuration
# ==========================================

# 1. Node-RED Instance Connection
NODE_RED_URL=http://localhost:1880
NODE_RED_TOKEN=

# 2. Node-RED Server Environment Paths
# Path to the user directory where Node-RED installs custom modules (contains package.json & node_modules)
NODE_RED_USER_DIR=/root/.node-red

# Directory on the server where offline package tarballs (.tar.gz) are stored
PACKAGES_POOL_DIR=./packages-pool

# 3. Security & Whitelist Policy
# Comma-separated list of allowed npm modules. Wildcard suffix supported (e.g. node-red-contrib-*, @flowfuse/*)
# Leave empty or set to * to allow all modules.
MODULE_WHITELIST=node-red-contrib-*,@flowfuse/*,node-red-node-*

# 4. Optional Reload Command
# Command to execute if dynamic hot-reloading fails or full restart is required
# Examples: "pm2 restart nodered" or "systemctl restart nodered"
NODE_RED_RELOAD_COMMAND=

# 5. MCP Transport Configuration
# Mode: "stdio" (for local Claude Desktop / Cursor / SSH tunnel) or "sse" (for remote HTTP/SSE connections)
MCP_TRANSPORT=sse

# Port and Host for SSE Transport Mode
MCP_PORT=3000
MCP_HOST=0.0.0.0
